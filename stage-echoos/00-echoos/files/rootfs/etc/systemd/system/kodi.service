[Unit]
Description=Kodi Media Center (Echo-OS)
After=plymouth-start.service systemd-user-sessions.service network-online.target seatd.service echoos-config.service
Wants=network-online.target
Conflicts=getty@tty1.service

[Service]
Type=simple
User=echoos
Group=echoos
SupplementaryGroups=video audio input render plugdev
PAMName=echoos
TTYPath=/dev/tty1
TTYReset=yes
TTYVHangup=yes
StandardInput=tty-fail
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
UtmpMode=user
# Bootscreen nahtlos an Kodi übergeben
ExecStartPre=+-/bin/plymouth quit --retain-splash
ExecStart=/usr/bin/kodi-standalone
Restart=on-failure
RestartSec=5
# Beim Beenden über das Kodi-Menü nicht neu starten
SuccessExitStatus=0 64 66

[Install]
WantedBy=multi-user.target
